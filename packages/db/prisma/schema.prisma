generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id                Int                 @id @default(autoincrement())
  email             String?             @unique
  name              String?
  number            String?             @unique
  password          String?
  OnRampTransaction OnRampTransaction[]
  Balance           Balance[]
  pinHash        String?
  pinAttempts    Int       @default(0)
  pinLockedUntil DateTime?
  sentTransfers     p2pTransfer[]       @relation(name: "FromUserRelation")
  receivedTransfers p2pTransfer[]       @relation(name: "ToUserRelation")
  merchantPayments  MerchantPayment[]
}
model p2pTransfer {
  id         Int      @id @default(autoincrement())
  amount     Int
  timestamp  DateTime
  fromUserId Int

  fromUser   User     @relation(name: "FromUserRelation", fields: [fromUserId], references: [id])
  toUserId   Int
  toUser     User     @relation(name: "ToUserRelation", fields: [toUserId], references: [id])
}
model OnRampTransaction {
  id        Int          @id @default(autoincrement())
  status    OnRampStatus
  token     String       @unique
  provider  String
  amount    Int
  startTime DateTime
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
}
model Balance {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  amount Int
  locked Int
  user   User @relation(fields: [userId], references: [id])
}

model Merchant {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  phone           String?   @unique
  password        String?
  name            String?
  businessName    String?
  auth_type       AuthType
  createdAt       DateTime  @default(now())
  kycStatus       KycStatus @default(PENDING)
  businessType    String?
  addressLine     String?
  city            String?
  state           String?
  pincode         String?
  panEnc          String?   // AES-GCM ciphertext
  panLast4        String?   // only part ever displayed
  gstin           String?
  kycSubmittedAt  DateTime?
  kycReviewedAt   DateTime?
  kycRejectReason String?
  balance         MerchantBalance?
  bankAccounts    BankAccount[]
  devices         Soundbox[]
  orders          SoundboxOrder[]
  payments        MerchantPayment[]
  settlements     Settlement[]
  publicId        String    @unique @default(uuid())
}
model MerchantBalance {
  id         Int      @id @default(autoincrement())
  merchantId Int      @unique
  amount     Int      @default(0)
  locked     Int      @default(0)
  merchant   Merchant @relation(fields: [merchantId], references: [id])
}

model BankAccount {
  id           Int          @id @default(autoincrement())
  merchantId   Int
  holderName   String
  accountNoEnc String       // AES-GCM ciphertext...
  last4        String
  ifsc         String
  fingerprint  String       // HMAC of account+ifsc, detects duplicates without decrypting
  isPrimary    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  merchant     Merchant     @relation(fields: [merchantId], references: [id])
  settlements  Settlement[]

  @@unique([merchantId, fingerprint])
  @@index([merchantId])
}
model SoundboxPlan {
  id          Int             @id @default(autoincrement())
  code        String          @unique
  name        String
  description String?
  price       Int             // paise
  active      Boolean         @default(true)
  orders      SoundboxOrder[]
}

model SoundboxOrder {
  id         Int         @id @default(autoincrement())
  merchantId Int
  planId     Int
  amount     Int         // price snapshot at purchase time, paise
  address    String
  status     OrderStatus @default(PLACED)
  createdAt  DateTime    @default(now())
  merchant   Merchant    @relation(fields: [merchantId], references: [id])
  plan       SoundboxPlan @relation(fields: [planId], references: [id])
  devices    Soundbox[]

  @@index([merchantId])
}
model Soundbox {
  id          Int            @id @default(autoincrement())
  deviceId    String         @unique
  secretHash  String         // sha256 of the device secret, never the secret itself
  status      DeviceStatus   @default(INACTIVE)
  language    String         @default("en")
  activatedAt DateTime?
  merchantId  Int?
  merchant    Merchant?      @relation(fields: [merchantId], references: [id])
  orderId     Int?
  order       SoundboxOrder? @relation(fields: [orderId], references: [id])

  @@index([merchantId])
}

// User to Merchant one
model MerchantPayment {
  id             Int       @id @default(autoincrement())
  merchantId     Int
  fromUserId     Int
  amount         Int
  status         TxnStatus @default(PENDING)
  idempotencyKey String    @unique
  note           String?
  createdAt      DateTime  @default(now())
  merchant       Merchant  @relation(fields: [merchantId], references: [id])
  fromUser       User      @relation(fields: [fromUserId], references: [id])

  @@index([merchantId, createdAt])
  @@index([fromUserId, createdAt])
}

// Merchant to bank one
model Settlement {
  id            Int              @id @default(autoincrement())
  merchantId    Int
  bankAccountId Int
  amount        Int
  status        SettlementStatus @default(PENDING)
  utr           String?          @unique
  createdAt     DateTime         @default(now())
  processedAt   DateTime?
  merchant      Merchant         @relation(fields: [merchantId], references: [id])
  bankAccount   BankAccount      @relation(fields: [bankAccountId], references: [id])
  idempotencyKey String?  @unique

  @@index([merchantId, createdAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorType String   // "USER" | "MERCHANT" | "SYSTEM"
  actorId   Int?
  action    String   // e.g. "SETTLEMENT_REQUESTED"
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorType, actorId, createdAt])
}


enum AuthType {
  Google
  Github
  Credentials
}

enum OnRampStatus {
  Success
  Failure
  Processing
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DeviceStatus {
  INACTIVE
  ACTIVE
  SUSPENDED
}

enum OrderStatus {
  PLACED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum TxnStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum SettlementStatus {
  PENDING
  PROCESSED
  FAILED
}